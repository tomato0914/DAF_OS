# OpenRouter（必須）
OPENROUTER_API_KEY=sk-or-...

# Notion連携（任意 - 未設定時はローカル memory/*.md を使用）
NOTION_API_KEY=secret_xxxxx
ORION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ATLAS_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SIRIUS_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOVA_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COSMOS_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Issues連携（任意 - 未設定時はIssueファイル生成のみで終了）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_OWNER=yourname
GITHUB_REPO_NAME=DAF_OS

# データ暗号化（任意 - services/encryption_service.py を使う場合のみ必須）
# 生成方法: python -c "from services.encryption_service import generate_key; print(generate_key())"
DAF_ENCRYPTION_KEY=

# 画像生成エンジン（任意 - 未設定時は pillow。Quest98時点はpillowのみ対応。
# 将来 openai / google / flux / stability 等へ切替予定）
IMAGE_RENDERER=pillow
